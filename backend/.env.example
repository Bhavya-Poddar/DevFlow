# DevFlow environment reference only; placeholders are intentionally not credentials.
# Spring Boot does not auto-load .env. See ENVIRONMENT_SETUP.md for Windows setup.

# Local development profile; schema updates are permitted only for loopback MySQL
# after the explicit confirmation below. Use a fresh disposable local schema.
SPRING_PROFILES_ACTIVE=dev
DEVFLOW_DB_URL=jdbc:mysql://localhost:3306/devflow_local_demo
DEVFLOW_DB_USERNAME=<local-mysql-user>
DEVFLOW_DB_PASSWORD=<set-locally-never-commit>
DEVFLOW_JWT_SECRET=<generate-locally-at-least-32-utf8-bytes>
DEVFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173
DEVFLOW_DEV_DB_CONFIRMATION=LOCAL_DATABASE_ONLY
DEVFLOW_PROFILE_PICTURE_DIR=<local-writable-profile-picture-directory>

# Optional bootstrap account: set all three locally or leave blank.
DEVFLOW_ADMIN_EMAIL=
DEVFLOW_ADMIN_PASSWORD=
DEVFLOW_ADMIN_NAME=

# Optional operational overrides (defaults are documented in ENVIRONMENT_SETUP.md).
DEVFLOW_API_DOCS_ENABLED=false
DEVFLOW_API_DOCS_PUBLIC_ACCESS=false
DEVFLOW_RATE_LIMIT_MAX_TRACKED_KEYS=100000
DEVFLOW_LOGIN_RATE_LIMIT_MAX_REQUESTS=20
DEVFLOW_LOGIN_RATE_LIMIT_WINDOW=15m
DEVFLOW_AUTOMATION_POLL_DELAY_MS=1000
DEVFLOW_AUTOMATION_INITIAL_DELAY_MS=1500

# Frontend local development; production builds require an HTTPS API origin.
VITE_API_BASE_URL=http://localhost:8080

# Optional GitHub integration. Disabled by default; never put real values here.
DEVFLOW_GITHUB_ENABLED=false
DEVFLOW_GITHUB_WEBHOOK_SECRET=
DEVFLOW_GITHUB_WEBHOOK_MAXREQUESTBYTES=1048576
DEVFLOW_GITHUB_APP_APPID=
DEVFLOW_GITHUB_APP_INSTALLATIONID=
DEVFLOW_GITHUB_APP_PRIVATEKEY=
DEVFLOW_GITHUB_APP_APIBASEURL=https://api.github.com
DEVFLOW_GITHUB_APP_ALLOWEDENTERPRISEHOSTS=
